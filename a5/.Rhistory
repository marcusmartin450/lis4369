geom_text(aes(label=manufacturer))
# save it to g as an object
g <- ggplot(mpg,mapping=aes(displ,hwy))
# the two lines below can not save anything to g
g + geom_point()
g + geom_col()
g <- g + geom_point()
g
# other mappings: color, alpha, size, shape
ggplot(mpg)+geom_point(aes(displ,hwy,color=class))
ggplot(mpg)+geom_point(aes(displ,hwy,alpha=class))
ggplot(mpg)+geom_point(aes(displ,hwy,size=class))
ggplot(mpg)+geom_point(aes(displ,hwy,shape=class)) #warning
# wrong grammar:
ggplot(mpg)
+ geom_point(aes(displ,hwy,color=class))
# Author: Marcus Martin
# Purpose: ggplot2 practice with mpg dataset
# install.packages("tidyverse") # <- run once if not already installed
library(ggplot2)
library(viridis)
# Explore mpg
?mpg
str(mpg)
# Scatterplot: relationship between displ & hwy
ggplot(data = mpg) +
geom_point(aes(x = displ, y = hwy))
# Equivalent ways of supplying data
ggplot() +
geom_point(data = mpg, mapping = aes(x = displ, y = hwy))
ggplot(data = mpg, aes(x = displ, y = hwy)) +
geom_point() +
geom_text(aes(label = manufacturer))
# Save plot object to g
g <- ggplot(mpg, mapping = aes(displ, hwy))
g + geom_point()
g + geom_col()
g <- g + geom_point()
g
# Other aesthetics: color
ggplot(mpg) + geom_point(aes(displ, hwy, color = class))
# Wrong grammar (will error if + is on a new line)
# ggplot(mpg)
# + geom_point(aes(displ, hwy, color = class))
# FIXED:
ggplot(mpg) +
geom_point(aes(displ, hwy, color = class))
# Fixed color
ggplot(mpg) + geom_point(aes(displ, hwy), color = "blue")
# Gradient scale
tmp <- 1:dim(mpg)[1]
ggplot(mpg) + geom_point(aes(displ, hwy, color = tmp))
# Trend lines
ggplot(mpg) + geom_smooth(aes(displ, hwy))
ggplot(mpg, aes(displ, hwy)) + geom_smooth() + geom_point()
ggplot(mpg, aes(displ, hwy)) + geom_smooth() + geom_point(aes(color = class))
ggsave("Plot1_rs.pdf")
# Bar charts: count of "class"
ggplot(data = mpg) + geom_bar(aes(x = class))
ggplot(data = mpg) + stat_count(aes(x = class))
# Aggregate manually
d2a <- aggregate(list(count = mpg$class),
by = list(class = mpg$class),
FUN = length)
ggplot(d2a) + geom_col(aes(class, count))
# tidyverse style
# d2 <- mpg %>% group_by(class) %>% summarise(count = n())
# ggplot(d2) + geom_col(aes(class, count))
# Add variable "trans"
ggplot(mpg) + stat_count(aes(x = class, fill = trans))
ggplot(mpg) + stat_count(aes(x = class, fill = trans), position = "dodge")
ggplot(mpg) + stat_count(aes(x = class, fill = trans),
position = position_dodge(preserve = "single"))
ggsave("Plot2_rs.pdf")
# Custom color palettes
f <- colorRampPalette(c("blue", "yellow", "red"))
types <- unique(mpg$trans)
pal <- f(length(types))
ggplot(mpg) +
stat_count(aes(x = class, fill = trans),
position = position_dodge(preserve = "single")) +
scale_fill_manual(values = pal)
ggplot(mpg) +
stat_count(aes(x = class, fill = trans),
position = position_dodge(preserve = "single")) +
scale_fill_brewer(palette = "Set3")
ggplot(mpg) +
stat_count(aes(x = class, fill = trans),
position = position_dodge(preserve = "single")) +
scale_fill_viridis(discrete = TRUE)
ggplot(mpg) +
stat_count(aes(x = class, fill = trans),
position = position_dodge(preserve = "single")) +
scale_fill_viridis(discrete = TRUE, option = "magma")
# Theme tweaks
ggplot(mpg) +
geom_point(aes(displ, hwy)) +
theme(axis.title = element_text(size = 15),
axis.line  = element_line(size = 1, arrow = arrow()))
ggplot(mpg) +
geom_point(aes(displ, hwy)) +
theme(axis.title  = element_text(size = 15),
axis.line.x = element_line(size = 1, arrow = arrow()),
axis.line.y = element_line(size = 2))
# Turn off legend
ggplot(mpg) +
stat_count(aes(x = class, fill = trans),
position = position_dodge(preserve = "single")) +
scale_fill_viridis(discrete = TRUE, option = "magma") +
theme(legend.position = "none")
# Justify angled text
ggplot(mpg) + geom_bar(aes(manufacturer))
ggplot(mpg) + geom_bar(aes(manufacturer)) +
theme(axis.text.x = element_text(angle = 45))
ggplot(mpg) + geom_bar(aes(manufacturer)) +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggsave("Plot3_rs.pdf")
# Flip coordinates
ggplot(mpg) + geom_bar(aes(manufacturer)) + coord_flip()
# Sorting
order <- sort(table(mpg$manufacturer))
ggplot(mpg) +
geom_bar(aes(factor(manufacturer, names(order)))) +
coord_flip()
ggsave("Plot4_rs.pdf")
# Faceting
ggplot(mpg) +
geom_point(aes(displ, hwy, color = trans), size = 2) +
scale_color_viridis(option = "magma", discrete = TRUE) +
ggtitle("Highway MPG x Displacement")
ggplot(mpg) +
geom_point(aes(displ, hwy, color = trans), size = 2) +
scale_color_viridis(option = "magma", discrete = TRUE) +
ggtitle("Highway MPG x Displacement") +
facet_wrap(~trans)
ggplot(mpg) +
geom_point(aes(displ, hwy, color = trans), size = 2) +
scale_color_viridis(option = "magma", discrete = TRUE) +
ggtitle("Highway MPG x Displacement") +
facet_wrap(~trans) +
theme(legend.position = "none")
ggplot(mpg) +
geom_point(aes(displ, hwy, color = trans), size = 1) +
scale_color_viridis(option = "magma", discrete = TRUE) +
ggtitle("Highway MPG x Displacement") +
facet_grid(cyl ~ trans) +
theme_minimal() +
theme(legend.position = "none")
ggsave("Plot5_rs.pdf")
# Author: Marcus Martin
# Purpose: dplyr + ggplot2 practice with nycflights data
install.packages("tidyverse")
install.packages("tidyverse")
install.packages("tidyverse")
# Purpose: layout
# Author: Qunfang
x <- 1:24
y <- rnorm(length(x))
A <- runif(n = length(x), min = 2, max = 9)
A <- A + y^2
B <- sample(c("D", "W"), size = length(x), replace = T)
# layout()
M <- matrix(
c(1,1,3
,1,1,3
,2,2,3)
, nrow = 3, byrow = TRUE
)
layout(M)
layout.show(1)
layout.show(2)
layout.show(3)
# plot 1
par(mar = c(0, 4, 4, 2), bty = "n")  # bottom, left, top, right
plot(x, y, type = "n", bty = "n", xaxt = "n", yaxt = "n",
ylab = "", xlab = "", ylim = c(2 * min(y), 2 * max(y)))
lines(x, y, type = "l", col = "purple", lty = 1, lwd = .5)
lines(x, y, type = "p", col = "purple", lty = 1, pch = "M", lwd = 2, cex = 1.6)
mtext(text = "Hourly Rate", side = 3, line = 1, cex = 1.3)
mtext("Volume", side = 2, line = 2)
# plot 2
par(mar = c(5, 4, 2, 2))
barplot(A, names.arg = 1:length(x), col = "purple", border = NA)
mtext("Freqs.", side = 2, line = 2)
# plot 3
par(mar = c(4, 4, 4, 4))
boxplot(A ~ B, col = "purple")
pdf("layout_qw.pdf", width = 6, height = 8, pointsize = 9)
dev.off()
M <- matrix(
c(1, 1, 3,
1, 4, 3,
2, 4, 3),
nrow = 3, byrow = TRUE
)
par(mar = c(4, 4, 4, 4))
pie(table(B), col = c("yellow", "purple"), border = NA)
