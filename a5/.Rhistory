##library(rmarkdown)
##file.choose()
##my.dir<-
##class.data <- read.csv(paste0(my.dir, "ClassNetwork.csv")
##  , header = TRUE, stringsAsFactors = FALSE)
##node.attributes <- read.csv(paste0(my.dir, "NodeAttributes.csv")
##, header = TRUE, stringsAsFactors = FALSE)
library(rmarkdown)
# Set your directory
my.dir <- "/Users/jaya/lis4701/"
# Load your data
class.data <- read.csv(
paste0(my.dir, "ClassNetwork.csv"),
header = TRUE,
stringsAsFactors = FALSE
)
node.attributes <- read.csv(
paste0(my.dir, "NodeAttributes.csv"),
header = TRUE,
stringsAsFactors = FALSE
)
# Check the structure
str(class.data)
str(node.attributes)
# Look at dimensions and first rows
dim(class.data)
head(class.data)
# Clean column names
colnames(class.data) <- gsub("\\.", "", colnames(class.data))
colnames(class.data)
# Assign row names
class.data$X <- colnames(class.data)[-1]
class(class.data)
# Create adjacency matrix
M <- as.matrix(class.data[, -1])
View(M)
rownames(M) <- class.data$X
M[is.na(M)] <- 0
# --- Build Graph ---
library(igraph)
g <- graph_from_adjacency_matrix(M)
class(g)
g
vcount(g)
ecount(g)
plot(g)
plot.igraph(g)
g <- simplify(g)
plot.igraph(g, edge.arrow.size = 0,
edge.arrow.width = 0,
main = "Class Networks")
par(mar = c(0, 0, 3, 0))
degree(g)
degree(g, mode = "in")
degree(g, mode = "out")
plot(degree(g))
par(mar = c(5, 8, 4, 1))
plot(sort(degree(g)))
hist(degree(g))
barplot(sort(degree(g)), horiz = TRUE, las = 2,
border = NA, col = "darkgreen",
main = "Most links", space = 1)
degree(g, mode = "out")
degree(g, mode = "in")
##YutingYuan nominated the most friends
##Karthi was nominated by the most people
# --- Betweenness ---
bt <- betweenness(g)      # UPDATED (store results)
bt
range(bt)
barplot(sort(bt), horiz = TRUE, las = 2,
border = NA, col = "red",
main = "Betweenness", space = 1)
par(mar = c(1, 7, 4, 1))
V(g)
V(g)$name
#############################################
# BEGIN UPDATED SECTION
# Fixing match() errors + fixing object names + fixing colors
#############################################
# Create working copy of node.attributes  (UPDATED)
node.attri <- node.attributes
# Clean names to match graph node names (remove spaces)  (UPDATED)
node.attri$name_nospace <- gsub(" ", "", node.attri$name)
# Match graph vertices to cleaned names  (UPDATED)
index <- match(V(g)$name, node.attri$name_nospace)
# Display alignment  (UPDATED)
cbind(V(g)$name, node.attri$name[index])
# Attach gender attribute to graph vertices  (UPDATED)
V(g)$gender <- node.attri$gender[index]
# Assign default color (dark green)  (UPDATED FIXED)
V(g)$color <- rgb(0, 139, 0, alpha = 180, maxColorValue = 255)
# Override female nodes with red  (UPDATED FIXED)
V(g)$color[V(g)$gender == "female"] <- rgb(255, 0, 0, alpha = 180, maxColorValue = 255)
# Plot colored network (UPDATED)
plot.igraph(
g,
vertex.color = V(g)$color,
edge.arrow.size = 0,
edge.arrow.width = 0,
main = "Class Network by Gender"
)
par(mar=c(1,1,4,1))
V(g)$size <- 2
plot.igraph(g)
V(g)$bet <- betweenness(g)
V(g)$size <- V(g)$bet
plot.igraph(g, main = "Scaling Nodes")
size <- V(g)$bet/max(V(g)$bet)
range(size)
V(g)$size <- round(10 + (10 * size), 0)
range(V(g)$size)
plot.igraph(g, main = "Scaling Nodes")
V(g)$label.color <- "black"
V(g)$deg.out <- degree(g, mode = "out")
V(g)$label.cex <- .25 + (V(g)$deg.out/max(V(g)$deg.out))
plot.igraph(g, edge.arrow.size = 0
, edge.arrow.width = 0
, main = "Label")
E(g)
E(g)$color <- "red"
V(g)$color[V(g)$name == "YutingYuan"] <- "blue"
plot.igraph(g)
E(g)[.from("YutingYuan")]$color <- "blue"
E(g)[.to("YutingYuan")]$color <- "blue"
plot.igraph(g)
E(g)[.from("YutingYuan")]$width <- 5
E(g)[.to("YutingYuan")]$width <- 5
plot.igraph(g)
##g1 <- delete_vertices(g, "YutingYuan")
##plot.igraph(g)
l <-layout_on_grid(g)
V(g)$x <- l[, 1]
V(g)$y <- l[, 2]
plot.igraph(g, main = "grid layout")
l <-layout_as_star(g, center = "YutingYuan")
V(g)$x <- l[, 1]
V(g)$y <- l[, 2]
plot.igraph(g, main = "grid layout")
l <-layout_as_tree(g, root = "YutingYuan")
V(g)$x <- l[, 1]
V(g)$y <- l[, 2]
plot.igraph(g, main = "grid layout")
source("~/.active-rstudio-document", echo = TRUE)
