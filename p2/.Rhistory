# 5) Display column names
print(names(mtcars))
# 6) Display first row
print(mtcars[1, ])
# 7) Display the 2nd column (mpg)
print(mtcars[, 2])
# 8) Display the "cyl" column by name
print(mtcars$cyl)
# 9) Display cell at row 3, column 4
print(mtcars[3, 4])
# 10) Display all cars with more than 4 cylinders
print(mtcars[mtcars$cyl > 4, ])
# 11) Display all cars with >4 cylinders AND >4 gears
print(mtcars[mtcars$cyl > 4 & mtcars$gear > 4, ])
# 12) Display all cars with >4 cylinders AND exactly 4 gears
print(mtcars[mtcars$cyl > 4 & mtcars$gear == 4, ])
# 13) Display all cars with >4 cylinders OR exactly 4 gears
print(mtcars[mtcars$cyl > 4 | mtcars$gear == 4, ])
# 14) Display all cars with >4 cylinders but NOT 4 gears
print(mtcars[mtcars$cyl > 4 & mtcars$gear != 4, ])
# 15) Display total number of rows
print(nrow(mtcars))
# 16) Display total number of columns
print(ncol(mtcars))
# 17) Display dimensions
print(dim(mtcars))
# 18) Display column names again
print(names(mtcars))
# 19) Statistics for horsepower (hp)
print(mean(mtcars$hp))
print(median(mtcars$hp))
print(min(mtcars$hp))
print(max(mtcars$hp))
print(quantile(mtcars$hp))
print(var(mtcars$hp))
print(sd(mtcars$hp))
# 20) Summary for horsepower
print(summary(mtcars$hp))
# 21A) Horsepower vs mpg
ggplot(mtcars, aes(x = hp, y = mpg, color = factor(cyl))) +
geom_point(size = 3) +
labs(title = "Horsepower vs MPG  Marcus Martin",
x = "Horsepower",
y = "Miles Per Gallon",
color = "Cylinders") +
theme_minimal()
# 21B) weifght vs mpg plot
plot(
mtcars$wt, mtcars$mpg,
main = "Weight vs MPG Marcus Martin",
xlab = "Weight",
ylab = "Miles Per Gallon",
pch = 19,
col = "blue"
)
